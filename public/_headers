# Cabeçalhos de segurança (Cloudflare Pages).
# Se o site passar a carregar algo de outro domínio (pixel, mapa, vídeo), libere o domínio na CSP.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://viacep.com.br; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Páginas com dados do pagamento na URL: não repassar a URL para outros sites
/obrigado
  ! Referrer-Policy
  Referrer-Policy: no-referrer
/conferir
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
