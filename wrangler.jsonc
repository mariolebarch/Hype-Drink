// Configuração do Cloudflare Workers (projeto "hype-drink", publicado a cada push na branch main).
// O site estático fica em public/; só as rotas /api/* passam pelo worker.js (pagamento online).
{
  "name": "hype-drink",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
